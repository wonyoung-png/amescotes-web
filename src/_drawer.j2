<aside id="drawer">
  <div class="lang mono">{% for l, p in langs %}<a href="{{ p }}" class="{{ 'on' if l == lang else '' }}" hreflang="{{ l }}">{{ l|upper }}</a>{% endfor %}</div>
  <a class="g1" href="{{ home_path }}#hero" data-go="hero"><b>{{ t.nav.home }}</b></a>
  <a class="g2" href="{{ home_path }}#story" data-go="story"><span class="mono">01</span>{{ t.nav.about }}</a>
  <a class="g2" href="{{ home_path }}#history" data-go="history"><span class="mono">02</span>{{ t.nav.history }}</a>
  <a class="g3" href="{{ home_path }}#works" data-go="works"><span class="mono">03</span>{{ t.nav.services }}</a>
  <a class="g3" href="{{ home_path }}#map" data-go="map"><span class="mono">04</span>{{ t.nav.global }}</a>
  <a class="g4" href="{{ home_path }}#range" data-go="range"><b>{{ t.nav.range }}</b></a>
  <a class="g4" href="{{ home_path }}#clients" data-go="clients">{{ t.nav.portfolio }}</a>
  <a class="g4" href="{{ home_path }}#journal" data-go="journal">{{ t.nav.journal }}</a>
  <a class="g4" href="{{ home_path }}#gallery" data-go="gallery">{{ t.nav.gallery }}</a>
  <a class="g5" href="{{ home_path }}#contact" data-go="contact"><b>{{ t.nav.contact }}</b></a>
</aside>
<div id="handle" title="{{ t.nav.menu }}">◀</div>
