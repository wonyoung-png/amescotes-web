<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
{% if base %}<base href="{{ base }}">{% endif %}
<title>{{ t.meta.title }}</title>
{% if site.noindex %}<meta name="robots" content="noindex">{% endif %}
<meta name="description" content="{{ t.meta.description }}">
<link rel="canonical" href="{{ site.url }}/{{ path }}">
{% for l, p in langs %}<link rel="alternate" hreflang="{{ l }}" href="{{ site.url }}/{{ p }}">
{% endfor %}<link rel="alternate" hreflang="x-default" href="{{ site.url }}/">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ t.meta.title }}">
<meta property="og:description" content="{{ t.meta.description }}">
<meta property="og:image" content="{{ site.url }}/{{ site.hero_image }}">
<link rel="icon" href="favicon.png">
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"AMESCOTES, Inc.","alternateName":"(주)아메스코테스","url":"{{ site.url }}","logo":"{{ site.url }}/amescotes_logo.png","email":"{{ site.email }}","foundingDate":"2017","address":{"@type":"PostalAddress","streetAddress":"보문로13나길 27","addressLocality":"성북구","addressRegion":"서울","addressCountry":"KR"},"sameAs":["https://blog.naver.com/amescotesofficial"]}</script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link rel="stylesheet" href="style.css?v={{ ver }}">
<style>.hero .bg{background-image:url({{ site.hero_image }})}#story .bg{background-image:url({{ site.about_image }})}</style>
</head>
<body class="drawer-closed">
<div id="loader"><img src="amescotes_logo.png" alt="AMESCOTES"></div>
<div class="logo-fixed"><img src="amescotes_logo.png" alt="AMESCOTES"></div>
{% include "_drawer.j2" %}

<section class="hero" id="hero">
  <div class="frame"><div class="bg"></div>
    <h1 class="disp">{% for ln in t.hero.title %}<span class="ln"><span>{{ ln }}</span></span>{% endfor %}</h1>
    <p class="sub">{{ t.hero.sub|safe }}</p>
    <a class="btn mono" data-go="works">{{ t.hero.button }} <i>→</i></a>
  </div>
</section>

<section id="story">
  <div class="sticky"><div class="bg"></div>
    <ul>{% for ln in t.about.lines %}<li>{{ ln }}</li>{% endfor %}</ul>
    {% for c in site.about_cards %}<div class="card{{ ' tall' if c.get('tall') else '' }}" data-i="{{ c.line }}"{% if c.get('pos') %} style="{{ c.pos }}"{% endif %}><span class="mono">{{ c.label }}</span><img src="{{ c.image }}" alt="{{ c.label }}" loading="lazy"></div>
    {% endfor %}<p class="end disp">{{ t.about.end }}</p>
  </div>
</section>

<section id="unfold">
  <div class="sticky">
    <h2 class="t0 disp">{{ t.business.intro }}</h2>
    <div class="win">{% for im in site.business_images %}<img class="{{ 'on' if loop.first else '' }}" src="{{ im }}" alt="" loading="lazy">{% endfor %}</div>
    <h2 class="tt disp">{% for s in t.business.slides %}<span class="{{ 'on' if loop.first else '' }}">{{ s|safe }}</span>{% endfor %}</h2>
    <div class="cols">{% for v in t.business['values'] %}<div><span class="mono">{{ v.tag }}</span><b>{{ v.title }}</b><p>{{ v.text }}</p></div>{% endfor %}</div>
  </div>
</section>

<section class="history" id="history">
  <h2 class="disp">{{ t.history.title }}</h2>
  <div class="hl">{% for y in site.history_years %}<div><span class="mono">{{ y }}</span><p>{{ t.history['items'][loop.index0]|safe }}</p></div>{% endfor %}</div>
</section>

<section class="vision" id="vision">
  <h2 class="disp">{{ t.vision.title|safe }}</h2>
  <div class="vg"><img src="img/deck/vision.jpg?v={{ ver }}" alt="" loading="lazy">
    <div class="vt">
      <div><span class="mono">Vision</span><p class="big">{{ t.vision.vision }}</p></div>
      <div><span class="mono">Mission</span><p>{{ t.vision.mission }}</p></div>
      <ol>{% for v in t.vision['values'] %}<li><span class="mono">{{ '%02d'|format(loop.index) }}</span><b>{{ v[0] }}</b><p>{{ v[1] }}</p></li>{% endfor %}</ol>
    </div>
  </div>
</section>

<section id="works"></section>

<section class="pps" id="pps">
  <div class="head"><h2 class="disp">{{ t.pps.title }}</h2><p>{{ t.pps.intro }}</p></div>
  {% set dur = ['CAD', '3 days~', '1 week~', '2 weeks~'] %}
  <div class="pg">{% for s in t.pps.steps %}<figure><img src="img/deck/pps{{ '%02d'|format(loop.index + 4) }}.jpg?v={{ ver }}" alt="{{ s[0] }}" loading="lazy"><figcaption><span class="mono">{{ '%02d'|format(loop.index) }} · {{ dur[loop.index0] }}</span><b>{{ s[0] }}</b><p>{{ s[1] }}</p></figcaption></figure>{% endfor %}</div>
  <div class="cmp">
    {% set od = ['', '2 weeks', '1 week', '2 weeks'] %}{% set nd = ['', '3 days', '1 week', '2 weeks'] %}
    <div class="row old"><span class="mono lab">{{ t.pps.old }}</span><div class="bar">{% for x in t.pps.old_steps %}<i style="flex:{{ [3, 14, 7, 14][loop.index0] }}"><em>{{ x }}</em><small class="mono">{{ od[loop.index0] }}</small></i>{% endfor %}</div><p>{{ t.pps.old_note }}</p></div>
    <div class="row new"><span class="mono lab">{{ t.pps.new }}</span><div class="bar">{% for s in t.pps.steps %}<i style="flex:{{ [3, 3, 7, 14][loop.index0] }}"><em>{{ s[0] }}</em><small class="mono">{{ nd[loop.index0] }}</small></i>{% endfor %}<i class="gap" style="flex:11"></i></div><p>{{ t.pps.new_note }}</p></div>
  </div>
</section>

<section class="map" id="map">
  <div class="head"><h2 class="disp">{{ t.global.title|safe }}</h2><p>{{ t.global.text }}</p></div>
  <svg id="globe" aria-label="map"></svg>
  <div class="card"><div class="k mono" id="mc-k"></div><h4 id="mc-h"></h4><p id="mc-p"></p></div>
  <div class="pills mono" id="map-tabs">{% for f in ['all','make','office','trade'] %}<button class="{{ 'on' if loop.first else '' }}" data-f="{{ f }}">{{ t.global.filters[loop.index0] }}</button>{% endfor %}</div>
</section>

<section class="net" id="network">
  <div class="nt"><div><span class="mono">Domestic</span><p>{{ t.net.domestic }}</p></div><div><span class="mono">Global</span><p>{{ t.net.global }}</p></div></div>
  <div class="ns">{% for i in range(1, 8) %}<img src="img/deck/net{{ '%02d'|format(i) }}.jpg?v={{ ver }}" alt="" loading="lazy">{% endfor %}</div>
</section>

<section class="clients" id="clients">
  <div class="head"><h2 class="disp">{{ t.portfolio.title|safe }}</h2><p style="max-width:380px;font-size:15px;line-height:1.7;color:var(--stone)">{{ t.portfolio.text }}</p></div>
  <div class="rows" id="rows">{% for r in range(2) %}<div class="row"><div class="track" data-dir="{{ 1 if r == 0 else -1 }}">{% for k in range(2) %}{% for c in site.clients[r::2] %}<div class="cell">{% if c.logo %}<img src="logo/{{ c.logo }}" alt="{{ c.name }}" draggable="false" loading="lazy">{% else %}<span class="txt">{{ c.name }}</span>{% endif %}<span class="nm mono">{{ c.name }}</span></div>{% endfor %}{% endfor %}</div></div>{% endfor %}</div>
</section>

<section class="products" id="products">
  <div class="head"><h2 class="disp">{{ t.products.title }}</h2><p>{{ t.products.text }}</p></div>
  <div class="pfeat">{% for p in site.products_featured %}<a href="{{ p.url }}" target="_blank" rel="noopener"><div class="im"><img src="img/deck/{{ p.img }}.webp?v={{ ver }}" alt="{{ p.brand }} {{ p.name }}" loading="lazy"></div><span class="mono">{{ p.brand }}</span><b>{{ p.name }}</b></a>{% endfor %}</div>
  <div class="pgd">{% for i in range(1, 37) %}<div><img src="img/deck/pf{{ '%02d'|format(i) }}.webp?v={{ ver }}" alt="" loading="lazy"></div>{% endfor %}</div>
</section>

<section class="caps" id="caps">
  <div class="head"><h2 class="disp">{{ t.caps.title|safe }}</h2><p>{{ t.caps.text }}</p></div>
  {% set cn = ['Bags', 'Belts', 'SLGs', 'Shoes', 'Etc.'] %}{% set ck = ['Form & Structure', 'Construction & Hardware', 'Range & Details', 'Last & Soles', 'Promos & Packaging'] %}
  <div class="cg">{% for n in cn %}<figure tabindex="0"><div class="im"><img src="img/deck/cat{{ '%02d'|format(loop.index) }}.webp?v={{ ver }}" alt="{{ n }}" loading="lazy"><img class="b" src="img/deck/cat{{ '%02d'|format(loop.index + 5) }}.jpg?v={{ ver }}" alt="" loading="lazy"></div><figcaption><b>{{ n }}</b><span class="mono">{{ ck[loop.index0] }}</span><p>{{ t.caps.cats[loop.index0] }}</p></figcaption></figure>{% endfor %}</div>
  <div class="head m"><h3 class="disp">{{ t.caps.mtitle|safe }}</h3><p>{{ t.caps.mtext }}</p></div>
  {% set mn = ['Leather', 'Leather Alternatives', 'Fur Materials', 'Natural Fibers', 'Synthetic Fibers'] %}{% set mk = ['Development & Finishing', 'Weaving & Construction', 'Shearing & Crimping', 'Embroidery & Sequin Work', 'Coating & Bonding'] %}
  <div class="cg">{% for n in mn %}<figure tabindex="0"><div class="im"><img src="img/deck/mat{{ '%02d'|format(loop.index) }}.webp?v={{ ver }}" alt="{{ n }}" loading="lazy"><img class="b" src="img/deck/mat{{ '%02d'|format(loop.index + 5) }}.jpg?v={{ ver }}" alt="" loading="lazy"></div><figcaption><b>{{ n }}</b><span class="mono">{{ mk[loop.index0] }}</span></figcaption></figure>{% endfor %}</div>
  <p class="hint mono">{{ t.caps.hint }}</p>
</section>

<section class="range" id="range">
  <h2 class="disp">{{ t.range.title }}</h2>
  <div class="rg">{% for g in t.range.groups %}<div><h3 class="mono">{{ g.label }}</h3><div class="chips">{% for it in g['items'] %}<span>{{ it }}</span>{% endfor %}</div></div>{% endfor %}</div>
</section>

<section class="journal" id="journal">
  <h2 class="disp">{{ t.journal.title|safe }}</h2>
  {% set j = site.journal %}{% set p = t.journal.posts %}
  <a class="big" href="journal/{{ j[0].slug }}.html"><img src="{{ j[0].image }}" alt="" loading="lazy"><div><span class="tag mono">{{ p[0].tag }}</span> <span class="mono" style="opacity:.55">· {{ j[0].date }}</span><h4>{{ p[0].title }}</h4></div></a>
  <div class="list">{% for i in range(1, j|length) %}<a href="journal/{{ j[i].slug }}.html"><div><span class="tag mono">{{ p[i].tag }}</span><h4>{{ p[i].title }}</h4><span class="mono" style="opacity:.55">{{ j[i].date }}</span></div><img src="{{ j[i].image }}" alt="" loading="lazy"></a>{% endfor %}</div>
</section>

<section class="gallery" id="gallery">
  <div class="ghead"><h2 class="disp">{{ t.gallery.title }}</h2><div><p>{{ t.gallery.sub }}</p>
    <div class="gpills mono" id="gf"><button class="on" data-t="all">{{ t.gallery.all }}</button><button data-t="photo">{{ t.gallery.photos }} · {{ photos }}</button><button data-t="video">{{ t.gallery.films }} · {{ videos }}</button></div></div></div>
  <div class="ggrid" id="gg">
  {% for it in gallery %}{% if it.type == 'photo' %}<figure class="it" data-t="photo" data-i="{{ loop.index0 }}"><img src="gallery/{{ it.id }}_s.jpg" width="{{ it.w }}" height="{{ it.h_px }}" alt="" loading="lazy" decoding="async"></figure>
  {% else %}<figure class="it" data-t="video" data-i="{{ loop.index0 }}"><span class="mono">Film</span><video muted loop playsinline preload="none" poster="gallery/{{ it.id }}_s.jpg" data-src="gallery/{{ it.id }}.mp4" width="{{ it.w }}" height="{{ it.h_px }}"></video></figure>
  {% endif %}{% endfor %}
  </div>
  <div class="gmore"><button id="gmore" class="mono">View more <i><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1v9M2 6.5 6 10.5 10 6.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></i></button><span class="mono" id="gcount"></span></div>
  <div id="lb"><button class="x" aria-label="close">✕</button><button class="pv" aria-label="prev">←</button><button class="nx" aria-label="next">→</button><div id="lbm"></div><div class="n mono" id="lbn"></div></div>
</section>

<section class="contact" id="contact">
  {% set f = t.contact %}
  <div class="wrap">
    <div><h2 class="disp">{{ f.title }}</h2><p class="note">{{ f.note|safe }}</p><p class="note mono" style="font-size:13px"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p></div>
    <form>
      <label>{{ f.company }}<input name="company" placeholder="{{ f.company_ph }}" required></label>
      <label>{{ f.name }}<input name="name" placeholder="{{ f.name_ph }}" required></label>
      <label>{{ f.phone }}<input name="phone" type="tel" placeholder="{{ f.phone_ph }}"></label>
      <label>{{ f.email }}<input name="email" type="email" placeholder="{{ f.email_ph }}" required></label>
      <label class="full">{{ f.site }}<div class="seg">{% for o in f.site_options %}<span class="{{ 'on' if loop.first else '' }}">{{ o }}</span>{% endfor %}</div></label>
      <label>{{ f.qty }}<input name="quantity" placeholder="{{ f.qty_ph }}"></label>
      <label>{{ f.type }}<select name="type">{% for o in f.type_options %}<option>{{ o }}</option>{% endfor %}</select></label>
      <label class="full">{{ f.message }}<textarea name="message" rows="4" placeholder="{{ f.message_ph }}" required></textarea></label>
      <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
      <label class="full" style="flex-direction:row;align-items:center;gap:8px"><input type="checkbox" required style="width:18px;height:18px">{{ f.consent }} <a href="{{ privacy_path }}" style="text-decoration:underline;opacity:.8">{{ f.privacy }}</a></label>
      <button type="submit">{{ f.submit }}</button>
    </form>
  </div>
</section>

<footer>
  <img class="bag" src="{{ site.footer_image }}" alt="">
  <div class="odo mono"><div>{{ t.footer.scrolled }}<b id="odo-m">0.0 m</b></div><div>{{ t.footer.stitches }}<b id="odo-s">0 {{ t.footer.unit }}</b></div></div>
  <div class="links"><div><div class="mono">{{ t.footer.explore }}</div><a data-go="hero">{{ t.nav.home }}</a><br><a data-go="works">{{ t.nav.services }}</a><br><a data-go="journal">{{ t.nav.journal }}</a><br><a data-go="gallery">{{ t.nav.gallery }}</a><br><a href="{{ privacy_path }}">{{ t.footer.privacy }}</a></div><div><div class="mono">{{ t.footer.contact }}</div>{{ site.email }}<br>{{ t.footer.address }}<br>{{ t.footer.biz }}</div></div>
</footer>

<script>const C={{ data|tojson }};const G={{ gallery_js|tojson }};</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://unpkg.com/lenis@1.1.13/dist/lenis.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/topojson-client@3.1.0/dist/topojson-client.min.js"></script>
<script src="app.js?v={{ ver }}"></script>
</body>
</html>
