<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
{% if base %}<base href="{{ base }}">{% endif %}
<title>{{ t.privacy.title }} — AMESCOTES</title>
<meta name="robots" content="noindex">
<link rel="icon" href="favicon.png">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300;6..72,400&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
body{margin:0;background:#EEF4EF;color:#0F1A16;font-family:'Pretendard Variable',Pretendard,sans-serif}
main{max-width:760px;margin:0 auto;padding:12vh 24px 16vh}
