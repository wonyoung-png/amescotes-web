<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<base href="{{ base }}">
<title>{{ head.title }} — AMESCOTES Journal</title>
{% if site.noindex %}<meta name="robots" content="noindex">{% endif %}
<meta name="description" content="{{ (post.blocks|selectattr('t','equalto','p')|first).v|join(' ')|truncate(150) }}">
<link rel="canonical" href="{{ site.url }}/journal/{{ meta.slug }}.html">
<meta property="og:title" content="{{ head.title }}">
<meta property="og:image" content="{{ site.url }}/{{ meta.image }}">
<link rel="icon" href="favicon.png">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link rel="stylesheet" href="style.css?v={{ ver }}">
<style>
.art{padding:0 0 10vh}
.art .top{padding:16vh 28px 6vh}
.art .crumb{display:flex;gap:10px;align-items:center;margin-bottom:4vh}
.art .crumb a{color:var(--stone)}
.art h1{font:300 clamp(44px,6.4vw,104px)/1.06 'Pretendard Variable',Pretendard,sans-serif;letter-spacing:-.045em}
.art .intro{font-size:16px;line-height:1.8;color:var(--stone)}
.art .lead{margin:0 6px 10vh;border-radius:14px;overflow:hidden;height:min(86vh,860px)}
.art .lead img{width:100%;height:100%;object-fit:cover}
.art .col{max-width:720px;margin:0 auto;padding:0 28px}
.art p{font-size:18px;line-height:1.9;color:#22332c;margin:0 0 1.1em}
.art p.k{font:500 11px 'Pretendard Variable',Pretendard,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin:6vh 0 1.4em;padding-top:18px;border-top:1px solid var(--line)}
.art .wide{padding:0 28px;margin:6vh 0 8vh}
.art .set{display:grid;gap:10px;grid-template-columns:repeat(var(--n),1fr);align-items:start}
.art .set.one{max-width:960px;margin:0 auto}
.art .set img{width:100%;height:auto;border-radius:8px;background:#E2ECE5;display:block}

.art .grp{display:grid;gap:10px}
.art .grp.n2{grid-template-columns:1fr 1fr}.art .grp.n3,.art .grp.n6{display:block;columns:3;column-gap:10px}.art .grp.n3 img,.art .grp.n6 img{margin-bottom:10px;break-inside:avoid}
.art .grp img{width:100%;height:auto;border-radius:8px;display:block}
.art .grp.n1{max-width:960px;margin:0 auto}.art .grp.n1 img{aspect-ratio:auto}
.art figcaption{font:500 11px 'Pretendard Variable',Pretendard,sans-serif;letter-spacing:.04em;color:var(--stone);margin-top:10px;line-height:1.5}
.art .src{max-width:720px;margin:10vh auto 0;padding:22px 28px 0;display:flex;justify-content:space-between;gap:16px;align-items:center;border-top:1px solid var(--line)}
.art .src a.mono{color:var(--stone)}
@media(max-width:820px){.art .top{grid-template-columns:1fr;padding-top:13vh}.art .lead{height:56vh}.art .set{grid-template-columns:1fr 1fr}.art .set.one{grid-template-columns:1fr}.art .grp.n3,.art .grp.n6{columns:2}.art p{font-size:16px}}
.art .chap{max-width:960px;margin:14vh auto 0;padding:26px 28px 0;border-top:1px solid var(--ink)}
.art .chap .mono{color:var(--accent);display:flex;gap:14px}.art .chap .mono span{color:var(--ink)}
.art .chap h2{font:700 clamp(34px,4.4vw,68px)/1.04 'Pretendard Variable',Pretendard,sans-serif;letter-spacing:-.04em;margin:18px 0 12px;text-wrap:balance}
.art .chap .sub{color:var(--stone)}
.art .chap+.wide{margin-top:5vh}
.art .chap+.wide .set.one{max-width:720px}
.art p.note{font-size:12px;line-height:1.6;color:var(--stone);margin-top:-.2em}
.art .srcs{list-style:none;padding:0;margin:0 0 1em;display:grid;gap:6px;font-size:13px}
.art .srcs li{display:flex;gap:10px;align-items:baseline}
.art .srcs .gr{font:600 11px 'Pretendard Variable',Pretendard,sans-serif;letter-spacing:.06em;color:var(--accent);min-width:46px}
.art .srcs a{color:var(--stone);text-decoration:underline;text-underline-offset:3px;word-break:break-word}
.art .tw{overflow-x:auto;margin:0 0 .6em}
.art .dt{border-collapse:collapse;width:100%;font-size:14px;font-variant-numeric:tabular-nums}
.art .dt th{text-align:left;font-weight:600;font-size:12px;color:var(--stone);border-bottom:1px solid var(--ink);padding:8px 10px}
.art .dt td{border-bottom:1px solid var(--line);padding:8px 10px}
.art .mk{background:#fff;border-radius:10px;padding:16px 18px;margin:0 0 1.4em}
.art .mk .mono{color:var(--accent)}
.art .mk ul{margin:8px 0 0;padding-left:18px;font-size:15px;line-height:1.75}
.art .colors{max-width:960px;margin:0 auto;display:grid;gap:5vh}
.art .cg2 h3{color:var(--accent);margin-bottom:14px}
.art .sw{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
.art .sw i{display:block;aspect-ratio:1;border-radius:8px}
.art .sw b{display:block;font-size:14px;font-weight:600;margin-top:10px}
.art .sw .mono{color:var(--stone);font-size:10px}
@media(max-width:820px){.art .sw{grid-template-columns:repeat(3,1fr)}.art .chap{margin-top:9vh;padding-left:16px;padding-right:16px}}
.next{display:block;background:var(--ink);color:#fff;padding:9vh 24px}
.next .in{padding:0 4px}
.next h3{font:300 clamp(28px,3.6vw,48px)/1.2 'Pretendard Variable',Pretendard,sans-serif;letter-spacing:-.03em;margin-top:12px}
.next:hover h3{text-decoration:underline;text-underline-offset:6px}
.mini-foot{padding:5vh 24px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:13px;color:var(--stone)}
</style>
</head>
<body class="drawer-closed">
<a class="logo-fixed" href="./" style="pointer-events:auto"><img src="amescotes_logo.png" alt="AMESCOTES"></a>
{% include "_drawer.j2" %}

<article class="art">
  <div class="top"><div><div class="crumb mono"><a href="./#journal">← Journal</a><span class="tag">{{ head.tag }}</span><span style="opacity:.55">{{ meta.date }}</span></div>
    <h1>{{ head.title }}</h1></div>
  </div>
  <div class="lead"><img src="{{ meta.image }}" alt=""></div>
  {% for b in post.blocks %}
    {% if b.t == 'p' %}<div class="col">
      {% for line in b.v %}{% if line %}
        {% if line|length < 40 and ((line == line|upper and line != line|lower) or line.startswith('TIP') or line.startswith('<')) %}<p class="k">{{ line }}</p>
        {% else %}<p>{{ line }}</p>{% endif %}
      {% endif %}{% endfor %}</div>
    {% elif b.t == 'h' %}<div class="chap"><div class="mono"><span>{{ b.n }}</span>{{ b.eyebrow }}</div><h2>{{ b.title }}</h2><div class="mono sub">{{ b.sub }}</div></div>
    {% elif b.t == 'note' %}<div class="col"><p class="note">{{ b.v }}</p></div>
    {% elif b.t == 'links' %}<div class="col"><ul class="srcs">{% for l in b.v %}<li><span class="gr">{{ l[0] }}</span><a href="{{ l[2] }}" target="_blank" rel="noopener">{{ l[1] }}</a></li>{% endfor %}</ul></div>
    {% elif b.t == 'table' %}<div class="col"><div class="tw"><table class="dt"><thead><tr>{% for h in b.head %}<th>{{ h }}</th>{% endfor %}</tr></thead><tbody>{% for r in b.rows %}<tr>{% for c in r %}<td>{{ c }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>{% if b.cap %}<p class="note">{{ b.cap }}</p>{% endif %}</div>
    {% elif b.t == 'check' %}<div class="col"><div class="mk"><span class="mono">만들 때 체크</span><ul>{% for x in b.v %}<li>{{ x }}</li>{% endfor %}</ul></div></div>
    {% elif b.t == 'colors' %}<div class="wide"><div class="colors">{% for g in b.groups %}<div class="cg2"><h3 class="mono">{{ g.label }}</h3><div class="sw">{% for c in g['items'] %}<figure><i style="background:{{ c[2] }}"></i><b>{{ c[0] }}</b><span class="mono">{{ c[1] }}</span></figure>{% endfor %}</div></div>{% endfor %}</div></div>
    {% elif b.t == 'set' %}
      {% set L = b.v|length %}{% set n = 1 if L == 1 else (4 if L % 4 == 0 else (3 if L % 3 == 0 else (2 if L % 2 == 0 else 3))) %}
      <div class="wide"><div class="set{{ ' portrait' if n > 1 else ' one' }}" style="--n:{{ n }}">{% for im in b.v %}<figure><img src="{{ im.src }}" width="{{ im.w }}" height="{{ im.h }}" alt="{{ im.cap }}" loading="lazy">{% if im.cap %}<figcaption>{{ im.cap }}</figcaption>{% endif %}</figure>{% endfor %}</div></div>
    {% else %}
      <figure class="wide"><div class="grp n{{ b.v|length if b.v|length in [2,3,6] else 1 }}">{% for im in b.v %}<img src="{{ im.src }}" width="{{ im.w }}" height="{{ im.h }}" alt="{{ b.cap }}" loading="lazy">{% endfor %}</div>{% if b.cap %}<figcaption>{{ b.cap }}</figcaption>{% endif %}</figure>
    {% endif %}
  {% endfor %}
  <div class="src"><span class="mono" style="color:var(--stone)">AMESCOTES Journal</span>{% if post.url %}<a class="mono" href="{{ post.url }}" target="_blank" rel="noopener">Naver blog 원문 ↗</a>{% else %}<span class="mono" style="color:var(--stone)">{{ head.tag }} · {{ meta.date }}</span>{% endif %}</div>
</article>

<a class="next" href="journal/{{ next_slug }}.html"><div class="in"><span class="mono" style="opacity:.6">Next · {{ next_head.tag }}</span><h3>{{ next_head.title }}</h3></div></a>
<div class="mini-foot"><span>ⓒ AMESCOTES, INC · {{ site.email }}</span><a href="./#contact">{{ t.nav.contact }} →</a></div>

<script>
const b=document.body;
document.getElementById('handle').onclick=()=>b.classList.remove('drawer-closed');
document.addEventListener('click',e=>{if(!e.target.closest('#drawer,#handle'))b.classList.add('drawer-closed')});
const lg=document.querySelector('.logo-fixed'),ld=document.querySelector('.lead');
const tone=()=>{const r=ld.getBoundingClientRect();lg.classList.toggle('on-light',!(r.top<=28&&r.bottom>28))};addEventListener('scroll',tone,{passive:true});tone();
</script>
</body>
</html>
